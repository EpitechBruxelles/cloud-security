aultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-logging-policies/logging-20"}, {"id": "CKV_AWS_305", "name": "Ensure CloudFront distribution has a default root object configured", "shortDescription": {"text": "Ensure CloudFront distribution has a default root object configured"}, "fullDescription": {"text": "Ensure CloudFront distribution has a default root object configured"}, "help": {"text": "Ensure CloudFront distribution has a default root object configured\nResource: module.environment.aws_cloudfront_distribution.public[0]"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-general-policies/bc-aws-305"}, {"id": "CKV_AWS_192", "name": "Ensure WAF prevents message lookup in Log4j2. See CVE-2021-44228 aka log4jshell", "shortDescription": {"text": "Ensure WAF prevents message lookup in Log4j2. See CVE-2021-44228 aka log4jshell"}, "fullDescription": {"text": "Ensure WAF prevents message lookup in Log4j2. See CVE-2021-44228 aka log4jshell"}, "help": {"text": "Ensure WAF prevents message lookup in Log4j2. See CVE-2021-44228 aka log4jshell\nResource: module.environment.aws_wafv2_web_acl.cloudfront[0]"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/aws-policies/aws-networking-policies/ensure-waf-prevents-message-lookup-in-log4j2"}, {"id": "CKV_AWS_118", "name": "Ensure that enhanced monitoring is enabled for Amazon RDS instances", "shortDescription": {"text": "Ensure that enhanced monitoring is enabled for Amazon RDS instances"}, "fullDescription": {"text": "Ensure that enhanced monitoring is enabled for Amazon RDS instances"}, "help": {"text": "Ensure that enhanced monitoring is enabled for Amazon RDS instances\nResource: module.environment.aws_db_instance.main[0]"}, "defaultConfiguration": {"level": "error"}, "help